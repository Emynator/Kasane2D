<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <IsPackable>true</IsPackable>
        <PackageId>Kasane2D.MonoGame</PackageId>
        <Version>1.0.0-rc.1</Version>
        <Authors>Emynator</Authors>
        <Description>
            MonoGame backend for the Kasane2D game engine.
        </Description>
        <PackageTags>
            monogame;kasane2d;backend
        </PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Emynator/Kasane2D</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Emynator/Kasane2D</PackageProjectUrl>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Kasane2D\Kasane2D.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
    </ItemGroup>

</Project>
